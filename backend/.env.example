# LLM API Configuration
# 默认使用 OpenAI 兼容接口，支持 DeepSeek / OpenAI / 其他兼容服务

# --- OpenAI 示例 ---
# OPENAI_API_KEY=sk-...
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o-mini

# --- DeepSeek 示例 ---
OPENAI_API_KEY=your_deepseek_api_key_here
OPENAI_BASE_URL=https://api.deepseek.com/v1
OPENAI_MODEL=deepseek-v4-pro

# 输出格式模式：
# - json_schema: OpenAI 原生严格 JSON Schema（需要服务商支持）
# - json_object: 兼容性更好，会将 Schema 写入 Prompt（推荐 DeepSeek 使用）
# - disabled: 不传递 response_format，最大兼容性
LLM_JSON_MODE=json_object

# Optional: 深度分析模型（用于 PRD 生成等复杂任务）
# OPENAI_DEEP_MODEL=deepseek-v4-pro

# Application
APP_NAME=App Review Analysis Agent
LOG_LEVEL=info
